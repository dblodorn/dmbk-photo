# Admin sign-in: the accounts API's Google OAuth client ID (public). Its
# authorized JavaScript origins must list https://photo.dmbk.io and
# http://localhost:3000, or Google refuses to render the sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional; defaults to production, https://graphql.dmbk.network/graphql.
# Every photo read and write, and admin sessions, go here.
DMBK_GRAPHQL_API_URL=

# This app's key for that API (server-only; never NEXT_PUBLIC_). Issued with
# `npm run api-client -- create dmbk-photo` in dmbk-graphql-api.
DMBK_GRAPHQL_API_KEY=

# Maintenance scripts only (scripts/backfill-*, cleanup-pending-photos,
# recount-keywords). They open dmbk-photos and the Space themselves; the app
# never does. Use a connection that can reach dmbk-photos (the API's).
MONGODB_URI=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
