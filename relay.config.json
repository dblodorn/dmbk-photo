{
  "src": "./src",
  "schema": "./schemas/dmbk-graphql-api.graphql",
  "language": "typescript",
  "eagerEsModules": true,
  "excludes": [
    "**/node_modules/**",
    "**/__generated__/**",
    "**/src/gql/**",
    "**/src/app/(site)/**",
    "**/src/lib/**",
    "**/src/server/**"
  ],
  "persistConfig": {
    "file": "./src/server/admin-graphql/persisted-operations.json",
    "algorithm": "SHA256"
  }
}
